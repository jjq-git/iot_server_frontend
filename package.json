{
  "name": "ito_admin_vue2",
  "version": "0.1.0",
  "private": true,
  "description": "Vue2 + BootstrapVue admin starter (Sneat-inspired)",
  "overrides": {
    "stylelint-config-recommended-vue": {
      "stylelint-config-recommended": "14.0.1"
    }
  },
  "scripts": {
    "dev": "webpack serve --mode development --env appMode=backend --open",
    "dev:fixed": "webpack serve --mode development --env appMode=backend --host 0.0.0.0 --port 46943 --no-open",
    "dev:demo": "webpack serve --mode development --env appMode=demo --port 46944 --no-open",
    "dev:demo:lan": "node scripts/start-demo-lan.mjs",
    "build": "webpack --mode production --env appMode=backend",
    "build:backend": "webpack --mode production --env appMode=backend",
    "build:demo": "webpack --mode production --env appMode=demo",
    "audit:demo-data": "node scripts/audit-demo-data.mjs",
    "generate:demo-contracts": "node scripts/generate-demo-contract-fixtures.mjs",
    "verify:demo-contracts": "node scripts/generate-demo-contract-fixtures.mjs --check",
    "verify:demo-artifact": "node scripts/verify-demo-artifact.mjs dist-demo",
    "smoke:demo": "node scripts/smoke-demo-release.mjs",
    "icons:generate": "node scripts/generate-icon-sprite.mjs",
    "icons:sync": "node scripts/sync-icon-snapshots.mjs",
    "test": "node --test tests",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium firefox webkit",
    "test:architecture": "node scripts/check-architecture.mjs",
    "test:canopen": "node --test tests/canopen-utils.test.mjs",
    "test:login-entry": "node --test tests/login-entry-contract.test.mjs",
    "test:widgets": "node --test tests/widget-contract.test.mjs",
    "test:permissions": "node --test tests/permission-contract.test.mjs",
    "test:enrollment": "node --test tests/device-enrollment-contract.test.mjs",
    "lint": "eslint src --ext .js,.vue",
    "lint:style": "stylelint \"src/**/*.{vue,scss,css}\"",
    "lint:style:fix": "stylelint \"src/**/*.{vue,scss,css}\" --fix"
  },
  "dependencies": {
    "@vue/composition-api": "^1.7.2",
    "ajv": "^8.17.1",
    "axios": "^1.6.7",
    "bootstrap": "^4.6.2",
    "bootstrap-vue": "^2.23.1",
    "dompurify": "^3.4.11",
    "echarts": "^5.6.0",
    "idb": "8.0.3",
    "js-sha256": "1.0.0",
    "marked": "^18.0.5",
    "msw": "2.15.0",
    "vue": "^2.6.14",
    "vue-echarts": "^6.7.3",
    "vue-i18n": "^8.28.2",
    "vue-router": "^3.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@playwright/test": "^1.55.0",
    "autoprefixer": "^10.4.19",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^6.11.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-vue": "^9.25.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.0",
    "postcss": "^8.4.38",
    "postcss-html": "^1.8.0",
    "postcss-loader": "^7.3.4",
    "postcss-pxtorem": "^6.1.0",
    "sass": "^1.77.5",
    "sass-loader": "^14.2.1",
    "style-loader": "^3.3.4",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^14.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "vue-loader": "^15.11.1",
    "vue-template-compiler": "^2.6.14",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
